    "languageModelTools": [
      {
        "name": "list_autocontext_instructions_files",
        "displayName": "List AutoContext Instructions",
        "modelDescription": "Lists AutoContext instruction files available in this workspace. Call this BEFORE generating, editing, or reviewing a file to discover which curated rules apply to it: pass the file's workspace-relative path (or a glob like 'src/**/*.ts') as `applyTo` and the catalogue is filtered to entries whose own `applyTo` glob matches. Optionally filter by `category` (e.g. 'language', 'framework'). Returns flat catalogue rows with name, label, description, version, applyTo, hasChangelog, and categories. Pass `includeSections: true` to also receive each file's heading index. Follow up with `get_autocontext_instructions_file` to fetch the body of any returned entry.",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "list_autocontext_instructions_files",
        "icon": "$(list-unordered)",
        "tags": [
          "autocontext",
          "instructions",
          "rules",
          "discovery",
          "catalog",
          "list",
          "browse"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "applyTo": {
              "type": "string",
              "description": "Workspace-relative file path or glob. Returns instruction files whose `applyTo` frontmatter glob matches this path or whose pattern overlaps this glob."
            },
            "category": {
              "type": "string",
              "description": "Exact category name to filter by (case-insensitive)."
            },
            "includeSections": {
              "type": "boolean",
              "description": "When true, each returned entry includes its `sections` heading index."
            }
          }
        }
      },
      {
        "name": "search_autocontext_instructions_files_by_metadata",
        "displayName": "Search AutoContext Instructions by Metadata",
        "modelDescription": "Predicate search over AutoContext instruction-file metadata. Use this for attribute-based questions like 'which rules have a Security section?' or 'which rules target *.cs files?'. The `predicate` object is an AND across keys; recognised fields and their match semantics are declared in this tool's `inputSchema.predicate.properties`. String values are case-insensitive regex; booleans and numbers match by equality; `categories` matches if any element matches; `applyTo` is a glob (not regex), so `{\"applyTo\": \"src/**/*.ts\"}` returns files whose `applyTo` overlaps that glob. When the predicate touches any `sections.*` field, each result includes `matchedAnchors` ready to chain into `get_autocontext_instructions_file({ name, sections: matchedAnchors })`. On invalid input the response is `{ kind: 'error', error, field, reason, recognizedFields: [{ field, type, match }, ...] }` — read `recognizedFields` to repair the predicate without an extra round-trip.",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "search_autocontext_instructions_files_by_metadata",
        "icon": "$(filter)",
        "tags": [
          "autocontext",
          "instructions",
          "rules",
          "discovery",
          "metadata",
          "search",
          "find"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "predicate": {
              "type": "object",
              "description": "AND-combined field constraints. Only the keys listed under `properties` are accepted; unknown keys produce an `unknown-field` error at runtime.",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "Case-insensitive regex matched against the full file name (including the `.instructions.md` suffix)."
                },
                "key": {
                  "type": "string",
                  "description": "Case-insensitive regex matched against the slug-only key (e.g. `lang-csharp`)."
                },
                "fileName": {
                  "type": "string",
                  "description": "Case-insensitive regex matched against the file name; equivalent to `name` for the curated catalogue."
                },
                "description": {
                  "type": "string",
                  "description": "Case-insensitive regex matched against the human-readable description."
                },
                "version": {
                  "type": "string",
                  "description": "Case-insensitive regex matched against the semver string (e.g. `^1\\.`)."
                },
                "applyTo": {
                  "type": "string",
                  "description": "Workspace glob (not regex). Returns files whose own `applyTo` glob overlaps this one."
                },
                "categories": {
                  "type": "string",
                  "description": "Case-insensitive regex; the file matches if any element of its `categories[]` matches."
                },
                "hasChangelog": {
                  "type": "boolean",
                  "description": "Exact equality."
                },
                "sections.heading": {
                  "type": "string",
                  "description": "Case-insensitive regex matched against any section's heading text. Intersects with other `sections.*` clauses inside the same section."
                },
                "sections.anchor": {
                  "type": "string",
                  "description": "Case-insensitive regex matched against any section's anchor slug. Intersects with other `sections.*` clauses inside the same section."
                },
                "sections.parent": {
                  "type": "string",
                  "description": "Case-insensitive regex matched against the parent heading text of nested (`###`) sections."
                },
                "sections.level": {
                  "type": "number",
                  "description": "Exact match: `2` for `##` headings, `3` for `###` headings."
                }
              }
            },
            "includeSections": {
              "type": "boolean",
              "description": "When true, each returned entry includes its full `sections` heading index in addition to any `matchedAnchors`."
            }
          }
        }
      },
      {
        "name": "search_autocontext_instructions_files_by_content",
        "displayName": "Search AutoContext Instructions by Content",
        "modelDescription": "Free-text search across the body of AutoContext instruction files. Use this for topical questions like 'does AutoContext require ConfigureAwait?' or 'how should I name xUnit tests?'. Returns ranked hits with `excerpts[]`, each carrying its `section`, `sectionLevel`, and `anchor`. Chain into `get_autocontext_instructions_file({ name, sections: [excerpts[i].anchor] })` to read just the relevant section. Optionally narrow with `applyTo` (workspace-relative path or glob) or exact `category` (case-insensitive).",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "search_autocontext_instructions_files_by_content",
        "icon": "$(search)",
        "tags": [
          "autocontext",
          "instructions",
          "rules",
          "discovery",
          "content",
          "search",
          "find"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "description": "Free-text query. Tokenized on word boundaries and identifier camelCase; matches against descriptions and bodies."
            },
            "applyTo": {
              "type": "string",
              "description": "Workspace-relative file path or glob. Drops hits whose `applyTo` does not match or overlap."
            },
            "category": {
              "type": "string",
              "description": "Exact category name to filter by (case-insensitive)."
            },
            "limit": {
              "type": "number",
              "description": "Maximum number of ranked hits (default 10, capped at 25)."
            }
          },
          "required": [
            "query"
          ]
        }
      },
      {
        "name": "get_autocontext_instructions_file",
        "displayName": "Get AutoContext Instructions File",
        "modelDescription": "Fetches the normalized markdown body of a single AutoContext instruction file by exact `name` (e.g. 'lang-csharp.instructions.md'). Pass `sections` to fetch only specific sections by anchor — typically chained from `matchedAnchors` (returned by `search_autocontext_instructions_files_by_metadata` when querying `sections.*`) or from `excerpts[].anchor` (returned by `search_autocontext_instructions_files_by_content`). Section slices are concatenated in document order and include their original headings. Unknown anchors are reported back via `notFoundSections`. Returns `{ kind: 'not-found' }` when `name` is unknown and `{ disabled: true }` when the user has disabled the file.",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "get_autocontext_instructions_file",
        "icon": "$(book)",
        "tags": [
          "autocontext",
          "instructions",
          "rules",
          "discovery",
          "fetch",
          "get",
          "read"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "Exact instruction file name including the `.instructions.md` suffix."
            },
            "sections": {
              "type": "array",
              "description": "Optional anchors to slice. Empty or omitted returns the whole body. Typically chained from `matchedAnchors` or `excerpts[].anchor`.",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "name"
          ]
        }
      }
    ],
