<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Version>0.9.5</Version>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!--
    Unmodified `dotnet new` templates the checks are measured against. They are
    analysed as input, never compiled, and are copied to the output with their
    project files so a check reading the nearest project sees the real one.
  -->
  <ItemGroup>
    <Compile Remove="Fixtures\**" />
    <None Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AutoContext.Worker.DotNet\AutoContext.Worker.DotNet.csproj" />
    <ProjectReference Include="..\AutoContext.Framework.Tests.Support\AutoContext.Framework.Tests.Support.csproj" />
  </ItemGroup>

</Project>
